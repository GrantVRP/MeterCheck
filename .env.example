# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Only NEXT_PUBLIC_* values are sent to the browser.

# AI sentence writer and sign photo check (server only, not built yet)
AI_API_KEY=
AI_MODEL=

# Optional. The Safe Browsing check is skipped if this is empty.
GOOGLE_SAFE_BROWSING_KEY=

# The owner area (/owner) password, 8 or more characters. Server only.
# On Cloudflare set it with: npx wrangler secret put OWNER_PASSWORD
# For npm run preview, put it in .dev.vars instead.
OWNER_PASSWORD=

# true = demo codes on /demo with saved results, demo reports on the map, "Demo" tag on every screen
NEXT_PUBLIC_DEMO_MODE=true
